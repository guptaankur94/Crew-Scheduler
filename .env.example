# GEMINI_API_KEY: Required for the AI features (roster and payslip reading).
# Create one at https://aistudio.google.com/apikey, then copy this file to ".env" and paste it below.
# Never commit your real .env file or share the key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODELS (optional): comma-separated models, tried in order until one answers.
# GEMINI_MODELS="gemini-3.8-flash,gemini-flash-latest,gemini-3.1-flash-lite"

# PORT (optional): the port the local server listens on. Defaults to 3000.
# PORT=3000

# GEMINI_DAILY_LIMIT (optional): most AI requests allowed per day, to cap cost. Defaults to 200.
# GEMINI_DAILY_LIMIT=200

# HOST (optional): the server only accepts requests from this computer (127.0.0.1) by default.
# Only change this when hosting the app online, and add login and other protection first.
# HOST=127.0.0.1
