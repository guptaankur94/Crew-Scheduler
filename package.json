{
  "name": "crewcircadian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "bundle:update": "node scripts/make-update-bundle.mjs",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "rulebook": "tsx scripts/rulebook.ts",
    "app:sync": "vite build && cap sync",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts && vite build",
    "phone:live:ios": "cap run ios --live-reload --host localhost --port 3000",
    "phone:live:android": "cap run android --live-reload --host localhost --port 3000 --forwardPorts 3000:3000",
    "phone:release-sync": "npm run app:sync",
    "eval:reading": "tsx scripts/reading-eval.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-updater": "8.52.1",
    "@ebarooni/capacitor-calendar": "8.7.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
